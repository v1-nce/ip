<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="summer.ui.MainWindow" stylesheets="@summer.css" styleClass="root-pane">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-scroll"
                    AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="48.0">
            <content>
                <VBox fx:id="dialogContainer" styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="48.0" styleClass="user-input"
                   promptText="Type a command..."
                   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="84.0" AnchorPane.bottomAnchor="0.0" />
        <Button mnemonicParsing="false" onAction="#handleUserInput" prefHeight="48.0" prefWidth="84.0"
                text="Send" styleClass="send-button"
                AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" />
    </children>
</AnchorPane>
